# Copy to .env (make up does this for you and generates SECRET_ENCRYPTION_KEY).
# Every setting is also a --flag; see `hooklane --help`.

# --- connections ---
DATABASE_URL=postgres://hooklane:hooklane@localhost:55432/hooklane
DATABASE_MAX_CONNECTIONS=20
KAFKA_BROKERS=localhost:19092
KAFKA_TOPIC=hooklane.deliveries
KAFKA_PARTITIONS=64
KAFKA_CONSUMER_GROUP=hooklane-workers
KAFKA_REPLICATION=1
QUEUE_MODE=kafka                     # kafka | postgres

# --- api ---
LISTEN_ADDR=0.0.0.0:8080
# Base64 of 32 random bytes. Generate: openssl rand -base64 32
SECRET_ENCRYPTION_KEY=

# --- outbound safety ---
ALLOW_HTTP=false
ALLOW_PRIVATE_ENDPOINTS=false        # true ONLY for local Docker networks
DELIVERY_TIMEOUT_MS=15000

# --- retries: delays before attempts 2..8 (ms) ---
RETRY_SCHEDULE_MS=5000,300000,1800000,7200000,18000000,36000000,36000000

# --- worker ---
PER_ENDPOINT_CONCURRENCY=1
PARTITION_MAX_IN_FLIGHT=256
LANE_MAX_QUEUED=100
PG_QUEUE_BATCH_SIZE=200
PG_QUEUE_CONCURRENCY=256

# --- circuit breaker ---
BREAKER_CONSECUTIVE_FAILURES=5
BREAKER_BASE_COOLDOWN_MS=30000
BREAKER_MAX_COOLDOWN_MS=600000

# --- relay ---
RELAY_BATCH_SIZE=500
RELAY_IDLE_SLEEP_MS=75

# --- scheduler ---
SCHEDULER_RETRY_INTERVAL_MS=1000
REAPER_INTERVAL_MS=15000
REAPER_STUCK_AFTER_MS=120000
AUTO_DISABLE_AFTER_SECS=432000
AUTO_DISABLE_INTERVAL_MS=60000

# --- telemetry ---
OTEL_EXPORTER_OTLP_ENDPOINT=
LOG_FORMAT=json                      # json | pretty
RUST_LOG=info
SHUTDOWN_GRACE_MS=25000
