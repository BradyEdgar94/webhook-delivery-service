        "ALLOW_PRIVATE_ENDPOINTS": "true",
        "ALLOW_HTTP": "true",
        "LOG_FORMAT": "pretty",
        "RUST_LOG": "info,hooklane=debug",
        "OTEL_EXPORTER_OTLP_ENDPOINT": "http://localhost:4318"
      },
      "cwd": "${workspaceFolder}"
    },
    {
      "type": "lldb",
      "request": "launch",
      "name": "Debug role: scheduler",
      "cargo": {
        "args": [
          "build",
          "--bin=hooklane",
          "--package=hooklane"
        ],
