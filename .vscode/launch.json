    {
      "type": "lldb",
      "request": "launch",
      "name": "Debug: unit tests (hooklane lib)",
      "cargo": {
        "args": [
          "test",
          "--no-run",
          "--lib",
          "--package=hooklane"
        ],
        "filter": {
          "name": "hooklane",
          "kind": "lib"
        }
      },
      "cwd": "${workspaceFolder}"
    },
    {
      "type": "lldb",
      "request": "launch",
      "name": "Debug: integration tests",
      "cargo": {
        "args": [
          "test",
          "--no-run",
          "--test=integration",
          "--package=hooklane"
        ],
        "filter": {
          "name": "integration",
          "kind": "test"
        }
      },
      "env": {
        "TEST_DATABASE_URL": "postgres://hooklane:hooklane@localhost:55432/postgres",
        "TEST_KAFKA_BROKERS": "localhost:19092"
      },
      "cwd": "${workspaceFolder}"
    }
  ]
