{
  "version": "0.2.0",
  "configurations": [
    {
      "type": "lldb",
      "request": "launch",
      "name": "Debug role: api",
      "cargo": {
        "args": [
          "build",
          "--bin=hooklane",
          "--package=hooklane"
        ],
        "filter": {
          "name": "hooklane",
          "kind": "bin"
        }
      },
      "args": [
        "--role",
        "api"
      ],
      "envFile": "${workspaceFolder}/.env",
      "env": {
        "DATABASE_URL": "postgres://hooklane:hooklane@localhost:55432/hooklane",
        "KAFKA_BROKERS": "localhost:19092",
        "ALLOW_PRIVATE_ENDPOINTS": "true",
        "ALLOW_HTTP": "true",
        "LOG_FORMAT": "pretty",
        "RUST_LOG": "info,hooklane=debug",
        "OTEL_EXPORTER_OTLP_ENDPOINT": "http://localhost:4318",
        "LISTEN_ADDR": "0.0.0.0:8085"
      },
      "cwd": "${workspaceFolder}"
    },
    {
      "type": "lldb",
      "request": "launch",
      "name": "Debug role: relay",
      "cargo": {
        "args": [
          "build",
